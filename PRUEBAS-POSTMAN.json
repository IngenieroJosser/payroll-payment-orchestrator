{
  "info": {
    "_postman_id": "f064bc0d-f68d-4e90-a67d-8fa87ab59d4e",
    "name": "Payroll Payment Orchestrator — flujo seguro",
    "description": "Flujo maker-checker parametrizado. No contiene credenciales ni datos bancarios reales.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "creatorEmail",
      "value": "",
      "type": "string"
    },
    {
      "key": "creatorPassword",
      "value": "",
      "type": "string"
    },
    {
      "key": "approverEmail",
      "value": "",
      "type": "string"
    },
    {
      "key": "approverPassword",
      "value": "",
      "type": "string"
    },
    {
      "key": "creatorToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "approverToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "companyId",
      "value": "",
      "type": "string"
    },
    {
      "key": "sourceAccountId",
      "value": "",
      "type": "string"
    },
    {
      "key": "batchId",
      "value": "",
      "type": "string"
    },
    {
      "key": "currency",
      "value": "COP",
      "type": "string"
    },
    {
      "key": "employeeDocumentType",
      "value": "CC",
      "type": "string"
    },
    {
      "key": "employeeDocumentNumber",
      "value": "",
      "type": "string"
    },
    {
      "key": "employeeFullName",
      "value": "",
      "type": "string"
    },
    {
      "key": "destinationBankCode",
      "value": "SANDBOX",
      "type": "string"
    },
    {
      "key": "destinationAccountType",
      "value": "SAVINGS",
      "type": "string"
    },
    {
      "key": "destinationAccountNumber",
      "value": "",
      "type": "string"
    },
    {
      "key": "paymentAmount",
      "value": "100000.00",
      "type": "string"
    },
    {
      "key": "scheduledDate",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Flujo de nómina",
      "item": [
        {
          "name": "1. Login creador",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{creatorEmail}}\",\n  \"password\": \"{{creatorPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Login creador exitoso\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set(\"creatorToken\", json.data.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Login aprobador",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{approverEmail}}\",\n  \"password\": \"{{approverPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Login aprobador exitoso\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set(\"approverToken\", json.data.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Crear lote",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{creatorToken}}",
                "type": "text"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/payroll-batches",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "payroll-batches"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"companyId\": \"{{companyId}}\",\n  \"sourceAccountId\": \"{{sourceAccountId}}\",\n  \"currency\": \"{{currency}}\",\n  \"scheduledDate\": \"{{scheduledDate}}\",\n  \"payments\": [\n    {\n      \"employeeDocumentType\": \"{{employeeDocumentType}}\",\n      \"employeeDocumentNumber\": \"{{employeeDocumentNumber}}\",\n      \"employeeFullName\": \"{{employeeFullName}}\",\n      \"bankCode\": \"{{destinationBankCode}}\",\n      \"accountType\": \"{{destinationAccountType}}\",\n      \"accountNumber\": \"{{destinationAccountNumber}}\",\n      \"amount\": \"{{paymentAmount}}\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get(\"scheduledDate\")) {",
                  "  const d = new Date(); d.setUTCDate(d.getUTCDate() + 1);",
                  "  pm.collectionVariables.set(\"scheduledDate\", d.toISOString().slice(0, 10));",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Lote creado\", () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set(\"batchId\", json.data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "4. Validar lote",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{creatorToken}}",
                "type": "text"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/payroll-batches/{{batchId}}/validate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "payroll-batches",
                "{{batchId}}",
                "validate"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Lote validado\", () => pm.expect(pm.response.code).to.be.oneOf([200,409]));"
                ]
              }
            }
          ]
        },
        {
          "name": "5. Aprobar lote",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{approverToken}}",
                "type": "text"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/payroll-batches/{{batchId}}/approve",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "payroll-batches",
                "{{batchId}}",
                "approve"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Lote aprobado\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "6. Ejecutar lote",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{creatorToken}}",
                "type": "text"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/payroll-batches/{{batchId}}/execute",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "payroll-batches",
                "{{batchId}}",
                "execute"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Ejecución aceptada\", () => pm.response.to.have.status(202));"
                ]
              }
            }
          ]
        },
        {
          "name": "7. Consultar lote",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{creatorToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/payroll-batches/{{batchId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "payroll-batches",
                "{{batchId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Consulta exitosa\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
