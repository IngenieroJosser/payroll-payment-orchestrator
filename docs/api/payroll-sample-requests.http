@baseUrl = http://localhost:8080
@token = REPLACE_BEARER_TOKEN
@devEmail = REPLACE_BOOTSTRAP_EMAIL
@devPassword = REPLACE_BOOTSTRAP_PASSWORD
@tenantId = REPLACE_TENANT_ID
@companyId = REPLACE_COMPANY_ID
@sourceAccountId = REPLACE_SOURCE_ACCOUNT_ID
@batchId = REPLACE_BATCH_ID

### Health
GET {{baseUrl}}/actuator/health

### Login de desarrollo
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "{{devEmail}}",
  "password": "{{devPassword}}"
}

### Crear tenant — requiere tenant:manage
POST {{baseUrl}}/api/v1/tenants
Authorization: Bearer {{token}}
Content-Type: application/json
Idempotency-Key: create-tenant-demo-0001

{
  "name": "Empresa Demo",
  "slug": "empresa-demo"
}

### Crear empresa — requiere company:manage
POST {{baseUrl}}/api/v1/companies
Authorization: Bearer {{token}}
Content-Type: application/json
Idempotency-Key: create-company-demo-0001

{
  "tenantId": "{{tenantId}}",
  "legalName": "Empresa Demo S.A.S.",
  "taxId": "900123456-7",
  "currency": "COP"
}

### Registrar cuenta de origen
POST {{baseUrl}}/api/v1/companies/{{companyId}}/bank-accounts
Authorization: Bearer {{token}}
Content-Type: application/json
Idempotency-Key: create-source-account-demo-0001

{
  "bankCode": "SANDBOX",
  "accountType": "CHECKING",
  "accountNumber": "1234567890"
}

### Configurar proveedor sandbox
POST {{baseUrl}}/api/v1/bank-connections
Authorization: Bearer {{token}}
Content-Type: application/json
Idempotency-Key: create-bank-connection-demo-0001

{
  "companyId": "{{companyId}}",
  "bankCode": "SANDBOX",
  "providerKey": "SANDBOX",
  "environment": "TEST",
  "connectTimeoutMs": 1000,
  "readTimeoutMs": 2000
}

### Crear lote
POST {{baseUrl}}/api/v1/payroll-batches
Authorization: Bearer {{token}}
Content-Type: application/json
Idempotency-Key: payroll-demo-0001

{
  "companyId": "{{companyId}}",
  "sourceAccountId": "{{sourceAccountId}}",
  "currency": "COP",
  "scheduledDate": "2026-08-07",
  "payments": [
    {
      "employeeDocumentType": "CC",
      "employeeDocumentNumber": "123456789",
      "employeeFullName": "Juan Pérez",
      "bankCode": "001",
      "accountType": "SAVINGS",
      "accountNumber": "9876543210",
      "amount": 2500000.00
    }
  ]
}

### Validar lote
POST {{baseUrl}}/api/v1/payroll-batches/{{batchId}}/validate
Authorization: Bearer {{token}}
Idempotency-Key: validate-payroll-demo-0001

### Aprobar lote con un usuario distinto al creador
POST {{baseUrl}}/api/v1/payroll-batches/{{batchId}}/approve
Authorization: Bearer {{token}}
Idempotency-Key: approve-payroll-demo-0001

### Ejecutar lote
POST {{baseUrl}}/api/v1/payroll-batches/{{batchId}}/execute
Authorization: Bearer {{token}}
Idempotency-Key: execute-payroll-demo-0001

### Consultar estado
GET {{baseUrl}}/api/v1/payroll-batches/{{batchId}}
Authorization: Bearer {{token}}
